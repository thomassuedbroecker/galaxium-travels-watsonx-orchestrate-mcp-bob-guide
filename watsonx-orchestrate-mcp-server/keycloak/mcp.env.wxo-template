# Settings for the OAuth 2.0 MCP variant configured for watsonx Orchestrate Developer Edition.
#
# Usage:
#   export LOCAL_NET_IP=$(ipconfig getifaddr en0)   # macOS
#   # Linux: export LOCAL_NET_IP=$(hostname -I | awk '{print $1}')
#
#   cp watsonx-orchestrate-mcp-server/keycloak/mcp.env.wxo-template \
#      infrastructure/galaxium-travels-infrastructure-tsuedbro/local-container/booking_system_mcp_oauth2_no_implicit_flow/mcp.env
#
#   sed -i.bak "s|<HOST_LAN_IP>|${LOCAL_NET_IP}|g" \
#      infrastructure/galaxium-travels-infrastructure-tsuedbro/local-container/booking_system_mcp_oauth2_no_implicit_flow/mcp.env

# Host ports
export MCP_HOST_PORT=8084
export KEYCLOAK_HOST_PORT=8086

# Public URLs: Must use the Host LAN IP so watsonx Orchestrate running inside Lima VM can reach them.
export KEYCLOAK_PUBLIC_BASE_URL=http://<HOST_LAN_IP>:8086
export MCP_PUBLIC_BASE_URL=http://<HOST_LAN_IP>:8084

# Client credentials for watsonx Orchestrate connection (client_credentials grant)
export OIDC_CLIENT_ID=web-app-proxy
export OIDC_CLIENT_SECRET=web-app-proxy-secret
