# -------------------------------------------------------
# watsonx Orchestrate Custom Explorer – environment vars
# -------------------------------------------------------
# URL of the running ibm-watsonx-orchestrate-mcp-server.
# Must match WXO_MCP_HOST and WXO_MCP_PORT in the MCP server's .env.
# The MCP server must be started BEFORE this app with:
#   cd watsonx-orchestrate-mcp-server && bash wxo_mcp_local_start.sh
export WXO_MCP_BASE_URL=http://127.0.0.1:8080

# Port on which this Flask application listens
export EXPLORER_PORT=5001

# Set to "true" to enable Flask debug mode (never in production)
export EXPLORER_DEBUG=false
